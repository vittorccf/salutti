DATABASE_URL="postgresql://postgres:postgres@localhost:5433/salutti"   # npm run db:local
AUTH_SECRET="troque-este-valor-em-producao"
NEXT_PUBLIC_APP_NAME="Salutti"

# Mock providers (em produção: chaves reais)
STRIPE_SECRET_KEY="sk_mock_stripe"   # sk_test_… ou sk_live_… ativa a cobrança real
STRIPE_WEBHOOK_SECRET=""             # whsec_… do endpoint /api/stripe/webhook
# Os preços (price_…) de cada plano ficam no backoffice → Planos, não aqui.
ASAAS_API_KEY="mock_asaas_key"
NFEIO_API_KEY="mock_nfeio_key"
WHATSAPP_BUSINESS_TOKEN="mock_wa_token"
OPENAI_API_KEY=""
RECEITA_SAUDE_TOKEN="mock_receita_saude"

# Videochamada (sem estas chaves, o link é simulado)
# Google Meet: cliente OAuth "Aplicativo da Web" da plataforma (Calendar API ativada, escopo calendar.events,
# URI de retorno <origem>/api/integracoes/google/retorno). Cada usuário conecta a própria conta em Ajustes.
# O mesmo cliente serve o "Entrar com Google": cadastre também <origem>/api/auth/google/retorno.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Domínio de produção (URI de retorno fixa do Google; previews usam outro domínio)
APP_URL=""
